GRANT SELECT, DELETE ON sf_maker_checker.outbox_event, sf_maker_checker.outbox_event_platform TO sf_outbox_publisher;
GRANT UPDATE (status, attempts, next_attempt_at, lease_owner, lease_expires_at, last_error_code, published_at)
  ON sf_maker_checker.outbox_event, sf_maker_checker.outbox_event_platform TO sf_outbox_publisher;

