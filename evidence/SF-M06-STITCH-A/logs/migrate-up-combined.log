  CHECK (
    (verification_status = 'VERIFIED' AND verified_at IS NOT NULL)
    OR (verification_status <> 'VERIFIED' AND verified_at IS NULL)
  ),
  CHECK (simulation IS NULL OR (simulation ->> 'simulation') = 'true')
);
