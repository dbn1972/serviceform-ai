CREATE FUNCTION sf_deficiency.reject_mutation()
RETURNS trigger
LANGUAGE plpgsql
SET search_path = sf_deficiency, pg_temp
AS $$
BEGIN
  RAISE EXCEPTION 'insert-only deficiency row' USING ERRCODE = '42501';
END;
$$;
