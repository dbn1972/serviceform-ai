CREATE FUNCTION sf_sla.reject_mutation()
RETURNS trigger
LANGUAGE plpgsql
SET search_path = sf_sla, pg_temp
AS $$
BEGIN
  RAISE EXCEPTION 'insert-only SLA row' USING ERRCODE = '42501';
END;
$$;
