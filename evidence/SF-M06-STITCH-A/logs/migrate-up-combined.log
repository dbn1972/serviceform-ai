ALTER TABLE sf_jurisdiction.inbox_event FORCE ROW LEVEL SECURITY;
CREATE POLICY inbox_event_tenant ON sf_jurisdiction.inbox_event TO sf_app
  USING (tenant_id = sf_platform.current_tenant_id())
  WITH CHECK (tenant_id = sf_platform.current_tenant_id());
GRANT SELECT, INSERT ON sf_jurisdiction.inbox_event TO sf_app;

-- sf:isolation sf_jurisdiction.inbox_event_platform PLATFORM_OPERATIONAL owner=CMP-003
CREATE TABLE sf_jurisdiction.inbox_event_platform (
  consumer_group text NOT NULL CHECK (consumer_group ~ '^[a-z0-9][a-z0-9._-]{0,99}$'),
  event_id uuid NOT NULL,
  processed_at timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (consumer_group, event_id)
);
GRANT SELECT, INSERT ON sf_jurisdiction.inbox_event_platform TO sf_app;

-- Outside frozen SF-CON-OUTBOX template body (columns/policies/grants above unchanged).
-- ADR-0006 #5: authoritative tables owned by sf_migrator, not the migrate LOGIN.
ALTER TABLE sf_jurisdiction.outbox_event OWNER TO sf_migrator;
ALTER TABLE sf_jurisdiction.outbox_event_platform OWNER TO sf_migrator;
