  CHECK (envelope ->> 'aggregate_id' = aggregate_id::text),
  CHECK (envelope ->> 'event_type' = event_type)
);
CREATE INDEX outbox_event_platform_claim_idx ON sf_fee.outbox_event_platform (partition_key, seq) WHERE status <> 'PUBLISHED';
CREATE INDEX outbox_event_platform_due_idx ON sf_fee.outbox_event_platform (next_attempt_at) WHERE status = 'PENDING';
GRANT INSERT ON sf_fee.outbox_event_platform TO sf_app;

GRANT USAGE ON SCHEMA sf_fee TO sf_outbox_publisher;
GRANT SELECT, DELETE ON sf_fee.outbox_event, sf_fee.outbox_event_platform TO sf_outbox_publisher;
GRANT UPDATE (status, attempts, next_attempt_at, lease_owner, lease_expires_at, last_error_code, published_at)
  ON sf_fee.outbox_event, sf_fee.outbox_event_platform TO sf_outbox_publisher;

-- sf:isolation sf_fee.inbox_event TENANT_SCOPED owner=CMP-020
CREATE TABLE sf_fee.inbox_event (
  consumer_group text NOT NULL CHECK (consumer_group ~ '^[a-z0-9][a-z0-9._-]{0,99}$'),
