{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/error-response/v1",
  "title": "ErrorResponse",
  "description": "HTTP error body: stable SF-* code, safe human message, correlation id and structured details. Never contains stack traces, SQL or raw exception text (AWS v1.7 s13.1, s13.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_code", "message", "correlation_id"],
  "properties": {
    "error_code": { "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/errorCode" },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "correlation_id": { "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid" },
    "details": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "maxLength": 100 },
          "pointer": {
            "type": "string",
            "maxLength": 300,
            "description": "JSON Pointer to the offending input."
          },
          "message": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
