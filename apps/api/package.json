    "@serviceform/observability": "workspace:*",
    "@serviceform/security": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.5",
    "fastify-plugin": "5.1.0",
    "fastify-rate-limit": "npm:@fastify/rate-limit@11.2.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "esbuild": "0.28.2"
