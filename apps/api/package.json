{
  "name": "@serviceform/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify application host for ServiceForm platform components (CMP-036 composition)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/under-pressure": "9.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@serviceform/cmp-002-tenant-organisation": "workspace:*",
    "@serviceform/cmp-031-audit-ledger": "workspace:*",
    "@serviceform/cmp-036-api-gateway": "workspace:*",
    "@serviceform/cmp-037-integration-hub": "workspace:*",
    "@serviceform/cmp-047-observability": "workspace:*",
    "@serviceform/cmp-048-security-platform": "workspace:*",
