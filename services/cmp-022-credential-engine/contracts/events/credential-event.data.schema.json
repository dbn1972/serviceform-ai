{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/cmp-022/credential-event-data/v1",
  "title": "Credential event data",
  "description": "Component-local. Data block of CredentialGenerated, CredentialSigned, CredentialSigningFailed and CredentialIssued on sf.credential.events.v1. References and hashes only: no artifact bytes, no template content, no PII. approval_decision_by_this_component is always false; CredentialIssued declares that publish/notification failure cannot reverse issuance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "application_id",
    "tenant_service_binding_id",
    "service_version_id",
    "credential_template_id",
    "credential_template_version",
    "issuance_key",
    "approval_decision_ref",
    "approval_decision_by_this_component",
    "lifecycle_status"
  ],
  "properties": {
    "credential_id": {
      "type": "string",
      "format": "uuid"
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_service_binding_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "credential_template_id": {
      "type": "string",
      "format": "uuid"
    },
    "credential_template_version": {
      "type": "integer",
      "minimum": 1
    },
    "issuance_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "approval_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "approval_decision_by_this_component": {
      "const": false
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["GENERATED", "SIGNED", "ISSUED"]
    },
    "unsigned_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signing_record_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "connector_mode": {
      "type": "string",
      "enum": ["REAL", "SANDBOX", "SIMULATED"]
    },
    "signed_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "failure_code": {
      "type": "string",
      "pattern": "^SF-(AUTH|TEN|FORM|RULE|APP|EVD|PAY|WF|CRED|INT|RATE|AI|SYS)-[0-9]{3}$"
    },
    "signed_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_key", "sha256"],
      "properties": {
        "storage_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "registry_status_owner_cmp": {
      "const": "CMP-024"
    },
    "issuance_reversible_by_publish_failure": {
      "const": false
    },
    "issuance_reversible_by_notification_failure": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "ISSUED"
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "required": [
          "signing_record_id",
          "signed_artifact",
          "issued_at",
          "registry_status_owner_cmp",
          "issuance_reversible_by_publish_failure",
          "issuance_reversible_by_notification_failure"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "SIGNED"
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "required": ["signing_record_id", "connector_mode", "signed_artifact_sha256"]
      }
    }
  ]
}
