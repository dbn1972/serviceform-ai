{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/cmp-022/ports/signing-adapter-result/v1",
  "title": "SigningAdapterResult",
  "description": "Component-local consumer port. Outcome returned by the CMP-037 INT-013 signing connector. CMP-022 turns it into SF-CON-SIGNING-RECORD. Mode comes from the connector binding. No eSign policy is defined here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector_binding_id", "integration_contract", "connector_mode", "signing_result"],
  "properties": {
    "connector_binding_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "integration_contract": {
      "const": "INT-013"
    },
    "connector_mode": {
      "type": "string",
      "enum": ["REAL", "SANDBOX", "SIMULATED"]
    },
    "simulation_marker": {
      "$ref": "https://contracts.serviceform.ai/simulation-marker/v1"
    },
    "signing_result": {
      "type": "string",
      "enum": ["SIGNED", "FAILED"]
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_./:-]+$"
    },
    "signed_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_transaction_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "failure_code": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/errorCode"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "connector_mode": {
            "const": "SIMULATED"
          }
        },
        "required": ["connector_mode"]
      },
      "then": {
        "required": ["simulation_marker"]
      },
      "else": {
        "not": {
          "required": ["simulation_marker"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "signing_result": {
            "const": "SIGNED"
          }
        },
        "required": ["signing_result"]
      },
      "then": {
        "required": ["signature_ref", "signed_artifact_sha256"],
        "not": {
          "required": ["failure_code"]
        }
      },
      "else": {
        "required": ["failure_code"]
      }
    }
  ]
}
