                  "required": ["signing_records"],
                  "properties": {
                    "signing_records": {
                      "type": "array",
                      "items": {
                        "$ref": "https://contracts.serviceform.ai/m07/signing-record/v1"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "SF-AUTH-001 / SF-TEN-001",
