{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/cmp-038/topic-registry-entry/v1",
  "title": "TopicRegistryEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_name",
    "owner_component",
    "tenancy",
    "partition_key_strategy",
    "partitions",
    "replication_factor",
    "broker_retention",
    "outbox_retention",
    "replay_class",
    "compatibility",
    "dlq_topic",
    "status",
    "schemas"
  ],
  "properties": {
    "topic_name": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{3,249}$" },
    "owner_component": { "type": "string", "pattern": "^CMP-0[0-9]{2}$" },
    "tenancy": { "enum": ["TENANT_SCOPED", "PLATFORM_OPERATIONAL"] },
    "partition_key_strategy": { "enum": ["AGGREGATE_ID", "DECLARED"] },
    "partitions": { "type": "integer", "minimum": 1 },
    "replication_factor": { "type": "integer", "minimum": 1 },
    "broker_retention": { "type": "string" },
    "outbox_retention": { "type": "string" },
    "replay_class": { "type": "string" },
    "compatibility": { "enum": ["BACKWARD", "FORWARD", "FULL"] },
    "dlq_topic": { "type": "string" },
    "status": { "enum": ["ACTIVE", "DEPRECATED"] },
    "schemas": { "type": "array", "items": { "type": "object" } }
  }
}
