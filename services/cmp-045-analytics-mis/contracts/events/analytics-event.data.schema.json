{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalyticsDefinitionEventData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definition_id",
    "metric_code",
    "version_no",
    "purpose_code",
    "source_event_type",
    "aggregation",
    "period_granularity",
    "min_cohort_size"
  ],
  "properties": {
    "definition_id": {
      "type": "string",
      "format": "uuid"
    },
    "metric_code": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "version_no": {
      "type": "integer",
      "minimum": 1
    },
    "purpose_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "source_event_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{2,79}$"
    },
    "aggregation": {
      "enum": ["COUNT", "SUM"]
    },
    "period_granularity": {
      "enum": ["HOUR", "DAY", "WEEK", "MONTH"]
    },
    "min_cohort_size": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "events_applied": {
      "type": "integer",
      "minimum": 0
    },
    "events_duplicate": {
      "type": "integer",
      "minimum": 0
    }
  },
  "description": "Event data carries definition identifiers and codes only. No metric values, dimension values, PII or payloads; metric reads are API-only under a declared purpose."
}
