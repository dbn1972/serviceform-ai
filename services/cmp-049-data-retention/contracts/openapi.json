{
  "openapi": "3.1.0",
  "info": {
    "title": "CMP-049 Data Retention / Archival",
    "version": "0.1.0",
    "description": "POLICY-NEUTRAL retention eligibility machinery (SF-CON-RETENTION-POLICY). Tenant from the server-derived request context only. No route accepts a retention period value, archives, purges or deletes data. ARCHIVE_ELIGIBLE/DELETE_ELIGIBLE fail closed (409 SF-APP-001 detail POLICY_INPUT_REQUIRED) until an owner binds owner_supplied_period_ref. Every route is a PEP call on OPA. Component-local contract; not shared-frozen."
  },
  "paths": {
    "/v1/retention/policies": {
      "post": {
        "operationId": "registerRetentionPolicy",
        "description": "PRIVILEGED_ADMIN/SYSTEM. Action RETENTION_POLICY_REGISTER.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
