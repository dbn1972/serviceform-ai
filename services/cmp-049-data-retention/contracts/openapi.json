              "schema": {
                "$ref": "#/components/schemas/RegisterPolicyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyView"
                }
              }
            }
          },
          "400": {
            "description": "SF-CON-ERROR-RESPONSE",
