{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/cmp-015/events/draft-created/v1",
  "title": "ApplicationDraftCreated data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "service_id",
    "state",
    "aggregate_version",
    "tenant_service_binding_id",
    "workflow_version_id",
    "pin_graph_hash",
    "authz_decision_id",
    "authz_policy_revision"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "service_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "const": "DRAFT"
    },
    "aggregate_version": {
      "const": 1
    },
    "tenant_service_binding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workflow_version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "pin_graph_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authz_decision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authz_policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
