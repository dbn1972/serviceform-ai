{
  "openapi": "3.1.0",
  "info": {
    "title": "CMP-015 Application / Case Management",
    "version": "0.1.0",
    "description": "Authoritative application/case aggregate (SF-CON-APPLICATION-CASE-SM, SF-CON-COMMAND-TRANSITION, SF-CON-VERSION-PINNING). CMP-015 is the sole owner of case state; Temporal (CMP-016) is signalled only after the domain commit. Tenant comes from the server-side RequestContext; tenant/role/actor headers are refused (SF-TEN-002). Paths are mounted under /v1 by the API host (SF-M05-009). Component-local contract; not shared-frozen."
  },
  "paths": {
    "/v1/applications": {
      "post": {
        "operationId": "createApplicationDraft",
        "summary": "Create a DRAFT pinned to the exact published TenantServiceBinding",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraftRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created (or idempotent replay with header Idempotent-Replayed: true)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "SF-CON-ERROR-RESPONSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://contracts.serviceform.ai/error-response/v1"
                }
              }
            }
          },
