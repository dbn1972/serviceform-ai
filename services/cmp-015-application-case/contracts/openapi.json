            "description": "SF-CON-ERROR-RESPONSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://contracts.serviceform.ai/error-response/v1"
                }
              }
            }
          },
          "403": {
            "description": "SF-CON-ERROR-RESPONSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://contracts.serviceform.ai/error-response/v1"
                }
              }
            }
          },
          "409": {
            "description": "SF-CON-ERROR-RESPONSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://contracts.serviceform.ai/error-response/v1"
                }
              }
            }
          },
          "422": {
            "description": "SF-CON-ERROR-RESPONSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://contracts.serviceform.ai/error-response/v1"
                }
              }
            }
          },
          "503": {
