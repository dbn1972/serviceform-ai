  "components": {
    "schemas": {
      "CaseState": {
        "type": "string",
        "enum": [
          "DRAFT",
          "READY_TO_SUBMIT",
          "SUBMITTED",
          "PAYMENT_PENDING",
          "RECEIVED",
          "UNDER_SCRUTINY",
          "DEFICIENCY_RAISED",
          "CITIZEN_RESPONSE",
          "VERIFICATION",
          "DECISION_PENDING",
          "APPROVED",
          "REJECTED",
          "SIGNING_PENDING",
          "ISSUED",
          "CLOSED",
          "WITHDRAWN",
          "CANCELLED"
        ],
        "description": "AWS v1.7 s12.1 legal states. WITHDRAWAL_REQUESTED / CANCELLATION_REQUESTED are never states (ADR-0003)."
      },
      "CreateDraftRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenant_service_binding_id"],
        "properties": {
          "tenant_service_binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "organisation_id": {
            "type": "string",
            "format": "uuid"
          },
          "jurisdiction_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Application": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application_id",
          "service_id",
          "state",
          "aggregate_version",
          "pins",
          "pin_graph_hash",
          "created_at",
          "updated_at",
          "submitted_at"
        ],
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "service_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "aggregate_version": {
            "type": "integer",
            "minimum": 1
          },
          "pins": {
            "$ref": "https://contracts.serviceform.ai/m05/version-pinning/v1#/$defs/pinGraph"
          },
          "pin_graph_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "submitted_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "ApplicationResponse": {
        "type": "object",
        "required": ["application"],
        "properties": {
          "application": {
            "$ref": "#/components/schemas/Application"
          }
        }
      },
      "CreateDraftResponse": {
        "type": "object",
        "required": ["application", "version_pinning"],
        "properties": {
          "application": {
            "$ref": "#/components/schemas/Application"
          },
          "version_pinning": {
            "$ref": "https://contracts.serviceform.ai/m05/version-pinning/v1"
          }
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_maker"],
        "properties": {
          "decision_maker": {
            "type": "string",
            "enum": ["HUMAN", "RULES", "AI"],
            "description": "AI is always refused (Constitution #20). HUMAN requires an OFFICER actor; RULES requires a SYSTEM actor and basis_ref."
          },
          "basis_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"
          },
          "ai_assisted": {
            "type": "boolean",
            "description": "Allowed only with decision_maker HUMAN (officer decides; AI assisted)."
          }
        }
      },
      "CommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "expected_state", "expected_version"],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "MARK_READY_TO_SUBMIT",
              "RETURN_TO_DRAFT",
              "SUBMIT",
              "ENTER_PAYMENT_PENDING",
              "MARK_RECEIVED",
              "ENTER_SCRUTINY",
              "RAISE_DEFICIENCY",
              "RECORD_CITIZEN_RESPONSE",
              "ENTER_VERIFICATION",
              "ENTER_DECISION_PENDING",
              "RECORD_APPROVED",
              "RECORD_REJECTED",
              "ENTER_SIGNING_PENDING",
              "RECORD_ISSUED",
              "CLOSE",
              "COMMIT_WITHDRAWAL",
              "COMMIT_CANCELLATION"
            ]
          },
          "expected_state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Required for COMMIT_WITHDRAWAL / COMMIT_CANCELLATION: a COMMITTED, unconsumed request reference."
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          }
        }
      },
      "Transition": {
        "type": "object",
        "properties": {
          "transition_id": {
            "type": "string",
            "format": "uuid"
          },
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "command": {
            "type": "string"
          },
          "from_state": {
            "type": ["string", "null"]
          },
          "to_state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "transition_key": {
            "type": ["string", "null"]
          },
          "transition_class": {
            "type": ["string", "null"],
            "enum": ["ALWAYS_LEGAL", "POLICY_GATED_WITHDRAWAL", "POLICY_GATED_CANCELLATION", null]
          },
          "aggregate_version": {
            "type": "integer"
          },
          "idempotency_key": {
            "type": "string"
          },
          "authz_decision_id": {
            "type": "string",
            "format": "uuid"
          },
          "authz_policy_revision": {
            "type": "string",
            "description": "Runtime OPA policy_revision for this action (ADR-0005)."
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_type": {
            "type": "string"
          },
          "reason_code": {
            "type": ["string", "null"]
          },
          "request_id": {
            "type": ["string", "null"]
          },
          "policy_ref": {
            "type": ["string", "null"]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TransitionListResponse": {
        "type": "object",
        "required": ["application_id", "transitions"],
        "properties": {
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "transitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transition"
            }
          }
        }
      },
      "CommandResponse": {
        "type": "object",
        "required": ["application", "transition"],
        "properties": {
          "application": {
            "$ref": "#/components/schemas/Application"
          },
          "transition": {
            "$ref": "#/components/schemas/Transition"
          },
          "workflow_advance": {
            "type": "string",
            "enum": ["SIGNALLED", "DEFERRED_TO_OUTBOX"],
            "description": "Absent on idempotent replay."
          },
          "command_transition": {
            "$ref": "https://contracts.serviceform.ai/m05/command-transition/v1"
          }
        }
      },
      "RegisterRequestRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["WITHDRAWAL", "CANCELLATION"]
          },
          "workflow_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "RequestStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "expected_status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["UNDER_REVIEW", "REJECTED", "EXPIRED", "COMMITTED"]
          },
          "expected_status": {
            "type": "string",
            "enum": ["SUBMITTED", "UNDER_REVIEW", "REJECTED", "EXPIRED", "COMMITTED"]
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          }
        }
      },
      "RequestReference": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": ["WITHDRAWAL", "CANCELLATION"]
          },
          "status": {
            "type": "string",
            "enum": ["SUBMITTED", "UNDER_REVIEW", "REJECTED", "EXPIRED", "COMMITTED"]
          },
          "workflow_ref": {
            "type": ["string", "null"]
          },
          "status_reason_code": {
            "type": ["string", "null"]
          },
          "case_state_at_request": {
            "$ref": "#/components/schemas/CaseState"
          },
          "consumed_at_version": {
            "type": ["integer", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_correlation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RequestResponse": {
        "type": "object",
        "required": ["request"],
        "properties": {
          "request": {
            "$ref": "#/components/schemas/RequestReference"
          },
          "application": {
            "$ref": "#/components/schemas/Application"
          }
        }
      }
    }
  }
}
