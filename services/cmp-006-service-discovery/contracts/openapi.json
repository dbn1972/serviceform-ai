{
  "openapi": "3.1.0",
  "info": {
    "title": "CMP-006 Service Discovery Engine",
    "version": "0.1.0",
    "description": "Tenant-safe, jurisdiction-aware service discovery over a pinned, published catalogue version (SF-CON-DISCOVERY-QUERY). Tenant comes from the server-derived request context only. Candidates come from CMP-035 search and are re-verified against CMP-001 catalogue entries and CMP-003 jurisdiction master data through ports. Results are catalogue/search projections, never statutory eligibility decisions (result_is_non_statutory=true). No route creates a form, draft or application: selectDiscoveredService only records a citizen's choice and emits DiscoveryServiceSelected for the INT-003 draft owner. Every route is a PEP call on OPA. Component-local contract; not shared-frozen."
  },
  "paths": {
    "/v1/discovery/queries": {
      "post": {
        "operationId": "runDiscoveryQuery",
        "description": "CITIZEN/OFFICER/PRIVILEGED_ADMIN/SYSTEM. Action DISCOVERY_QUERY. Records CMP-006's own query log (raw keywords are not stored).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DiscoveryQueryRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discovery results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiscoveryQueryResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/discovery/queries/{query_id}": {
      "get": {
        "operationId": "getDiscoveryQuery",
        "description": "Action DISCOVERY_QUERY_READ. A citizen sees only queries they ran (others are 404).",
        "parameters": [{ "$ref": "#/components/parameters/QueryId" }],
        "responses": {
          "200": {
            "description": "Stored query and results",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/StoredQueryView" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/discovery/queries/{query_id}/selections": {
      "post": {
        "operationId": "selectDiscoveredService",
        "description": "CITIZEN only, owner of the query. Action DISCOVERY_SERVICE_SELECT. INT-003 hand-off: records the selection and emits DiscoveryServiceSelected with catalogue + TenantServiceBinding pins. Does not create a draft.",
        "parameters": [
          { "$ref": "#/components/parameters/QueryId" },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{8,128}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SelectionRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "Selection recorded",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SelectionView" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "QueryId": {
        "name": "query_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "Error": {
        "description": "SF-CON-ERROR-RESPONSE",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      }
    },
    "schemas": {
      "ErrorResponse": { "$ref": "https://contracts.serviceform.ai/error-response/v1" },
      "DiscoveryQuery": { "$ref": "https://contracts.serviceform.ai/m08/discovery-query/v1" },
      "Code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$" },
      "DiscoveryQueryRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "The SF-CON-DISCOVERY-QUERY envelope minus server-owned fields (tenant_id, query_id, correlation_id). Constant markers may be echoed but never changed.",
        "required": ["filters", "catalogue_version_id", "pagination"],
        "properties": {
          "contract_id": { "const": "SF-CON-DISCOVERY-QUERY" },
          "contract_status": { "const": "FROZEN" },
          "freeze_status": { "const": "FROZEN" },
          "result_is_non_statutory": { "const": true },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["jurisdiction_codes"],
            "properties": {
              "jurisdiction_codes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "$ref": "#/components/schemas/Code" }
              },
              "service_codes": {
                "type": "array",
                "maxItems": 32,
                "items": { "$ref": "#/components/schemas/Code" }
              },
              "keywords": {
                "type": "array",
                "maxItems": 8,
                "items": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            }
          },
          "catalogue_version_id": { "type": "string", "format": "uuid" },
          "pagination": {
            "type": "object",
            "additionalProperties": false,
            "required": ["limit", "offset"],
            "properties": {
              "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
              "offset": { "type": "integer", "minimum": 0, "maximum": 10000 }
            }
          },
          "locale": { "type": "string", "minLength": 2, "maxLength": 35 }
        }
      },
      "ResultItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "service_id",
          "service_code",
          "category_code",
          "service_binding_version_id",
          "catalogue_version_id",
          "matched_jurisdiction_codes",
          "label"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "service_id": { "type": "string", "format": "uuid" },
          "service_code": { "$ref": "#/components/schemas/Code" },
          "category_code": { "type": ["string", "null"] },
          "service_binding_version_id": { "type": "string", "format": "uuid" },
          "catalogue_version_id": { "type": "string", "format": "uuid" },
          "matched_jurisdiction_codes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/Code" }
          },
          "label": { "type": ["string", "null"] }
        }
      },
      "PageView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit", "offset", "next_offset"],
        "properties": {
          "limit": { "type": "integer" },
          "offset": { "type": "integer" },
          "next_offset": { "type": ["integer", "null"] }
        }
      },
      "DiscoveryQueryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "results",
          "pagination",
          "excluded_count",
          "localization_status",
          "result_is_non_statutory",
          "draft_created",
          "created_at"
        ],
        "properties": {
          "query": { "$ref": "#/components/schemas/DiscoveryQuery" },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/ResultItem" } },
          "pagination": { "$ref": "#/components/schemas/PageView" },
          "excluded_count": { "type": "integer", "minimum": 0 },
          "localization_status": { "enum": ["NOT_REQUESTED", "RESOLVED", "UNAVAILABLE"] },
          "result_is_non_statutory": { "const": true },
          "draft_created": { "const": false },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "StoredQueryView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "keyword_count",
          "results",
          "pagination",
          "excluded_count",
          "result_is_non_statutory",
          "created_at"
        ],
        "properties": {
          "query": { "$ref": "#/components/schemas/DiscoveryQuery" },
          "keyword_count": { "type": "integer", "minimum": 0 },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/ResultItem" } },
          "pagination": { "$ref": "#/components/schemas/PageView" },
          "excluded_count": { "type": "integer", "minimum": 0 },
          "result_is_non_statutory": { "const": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SelectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id"],
        "properties": { "service_id": { "type": "string", "format": "uuid" } }
      },
      "SelectionView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_id",
          "query_id",
          "service_id",
          "service_code",
          "service_binding_version_id",
          "catalogue_version_id",
          "selected_at",
          "result_is_non_statutory",
          "draft_created"
        ],
        "properties": {
          "selection_id": { "type": "string", "format": "uuid" },
          "query_id": { "type": "string", "format": "uuid" },
          "service_id": { "type": "string", "format": "uuid" },
          "service_code": { "$ref": "#/components/schemas/Code" },
          "service_binding_version_id": { "type": "string", "format": "uuid" },
          "catalogue_version_id": { "type": "string", "format": "uuid" },
          "selected_at": { "type": "string", "format": "date-time" },
          "result_is_non_statutory": { "const": true },
          "draft_created": { "const": false }
        }
      }
    }
  }
}
