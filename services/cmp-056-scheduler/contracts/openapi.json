{
  "openapi": "3.1.0",
  "info": {
    "title": "CMP-056 Scheduler & Appointment Service",
    "version": "0.1.0",
    "description": "Reusable appointment, hearing, interview, counter-visit and inspection scheduling (INT-014). Produces SF-CON-APPOINTMENT v1 (FROZEN, contracts/m09/schemas/appointment.schema.json). Slots are explicit tenant-published metadata; CMP-056 never invents a statutory calendar. Capacity is atomic; notification failure never invalidates a committed booking. Tenant and actor are server-derived (SF-CON-REQUEST-CONTEXT); tenant-identifying headers are refused. Component-local contract; not shared-frozen."
  },
  "paths": {
    "/v1/appointment-slots": {
      "post": {
        "operationId": "publishAppointmentSlot",
        "description": "Publishes one explicit bookable slot from tenant metadata (SYSTEM/OFFICER). CMP-056 holds no business calendar, holiday list or statutory hearing/inspection calendar; slots are concrete windows with a fixed capacity.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlotInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Slot published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "200": {
            "description": "Identical request already recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "400": {
            "description": "SF-SYS-003 (validation; CLIENT_AUTHORITY_FORBIDDEN; CLIENT_TIME_NOT_AUTHORITATIVE; IDEMPOTENCY_KEY_REQUIRED; UUID_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "SF-AUTH-001 / SF-TEN-001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "SF-AUTH-002 / SF-TEN-002 (OPA deny, actor not permitted, tenant-identifying header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "SF-APP-001 (INVALID_APPOINTMENT_TRANSITION, SLOT_CAPACITY_EXHAUSTED, SLOT_CLOSED, SLOT_ALREADY_STARTED, SAME_SLOT, APPOINTMENT_TYPE_MISMATCH, APPOINTMENT_NOT_STARTED) / SF-APP-002 (idempotency or outcome conflict)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "SF-SYS-004 (PDP unavailable; fail closed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/appointments/slots": {
      "get": {
        "operationId": "listAppointmentSlots",
        "description": "Lists bookable slots only: OPEN, not yet started (server clock) and with a free seat.",
        "parameters": [
          {
            "name": "appointment_type_ref",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          {
            "name": "resource_calendar_ref",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bookable slots",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotList"
                }
              }
            }
          },
          "400": {
            "description": "SF-SYS-003 (validation; CLIENT_AUTHORITY_FORBIDDEN; CLIENT_TIME_NOT_AUTHORITATIVE; IDEMPOTENCY_KEY_REQUIRED; UUID_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "SF-AUTH-001 / SF-TEN-001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "SF-AUTH-002 / SF-TEN-002 (OPA deny, actor not permitted, tenant-identifying header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "SF-SYS-004 (PDP unavailable; fail closed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/appointments": {
      "post": {
        "operationId": "bookAppointment",
        "description": "Books one seat (CITIZEN/OFFICER/SYSTEM). The seat is taken by a single conditional UPDATE in the booking transaction, so concurrent requests cannot overbook (capacity_atomic). AppointmentBooked is written to the outbox in the same commit; CMP-025 notification happens downstream and its failure never invalidates the booking.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Appointment booked (SF-CON-APPOINTMENT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            }
          },
          "400": {
            "description": "SF-SYS-003 (validation; CLIENT_AUTHORITY_FORBIDDEN; CLIENT_TIME_NOT_AUTHORITATIVE; IDEMPOTENCY_KEY_REQUIRED; UUID_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "SF-AUTH-001 / SF-TEN-001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "SF-AUTH-002 / SF-TEN-002 (OPA deny, actor not permitted, tenant-identifying header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "SF-SYS-002 (not found, other tenant, or citizen not the booker)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "SF-APP-001 (INVALID_APPOINTMENT_TRANSITION, SLOT_CAPACITY_EXHAUSTED, SLOT_CLOSED, SLOT_ALREADY_STARTED, SAME_SLOT, APPOINTMENT_TYPE_MISMATCH, APPOINTMENT_NOT_STARTED) / SF-APP-002 (idempotency or outcome conflict)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "SF-SYS-004 (PDP unavailable; fail closed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
