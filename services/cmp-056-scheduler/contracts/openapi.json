            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "jurisdiction_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
