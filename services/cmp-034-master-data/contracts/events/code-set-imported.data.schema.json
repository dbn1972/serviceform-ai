{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serviceform.ai/schemas/cmp-034/code-set-imported.data.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["code_set_id", "version_no", "import_id", "source_mode", "item_count"],
  "properties": {
    "code_set_id": { "type": "string", "format": "uuid" },
    "version_no": { "type": "integer", "minimum": 1 },
    "import_id": { "type": "string", "format": "uuid" },
    "source_mode": { "type": "string", "enum": ["INLINE", "CONNECTOR"] },
    "item_count": { "type": "integer", "minimum": 1, "maximum": 500 }
  }
}
