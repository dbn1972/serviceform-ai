{
  "openapi": "3.1.0",
  "info": {
    "title": "CMP-019 Deficiency / Clarification Service",
    "version": "0.1.0",
    "description": "Reusable deficiency notices, requested items, citizen responses, evidence refs, due dates and closure. INT-009 SLA pause/resume and CMP-015 case commands are ports called after commit. Notification is M06 CMP-025 only. Component-local contract; not shared-frozen."
  },
  "paths": {
    "/v1/deficiencies": {
      "post": {
        "operationId": "openDeficiency",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "application_id",
                  "reason_code",
                  "notice_code",
                  "instruction_ref",
                  "case_expected_state",
                  "case_expected_version",
                  "items"
                ],
                "properties": {
                  "application_id": { "type": "string", "format": "uuid" },
                  "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
                  "notice_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
                  "instruction_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "sla_pause_reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
                  "sla_stage_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
                  "response_due_at": { "type": "string", "format": "date-time" },
                  "case_expected_state": { "type": "string" },
                  "case_expected_version": { "type": "integer", "minimum": 1 },
                  "items": { "type": "array", "minItems": 1, "maxItems": 32 },
                  "evidence": { "type": "array", "maxItems": 32 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Opened" },
          "400": { "description": "SF-SYS-003" },
          "401": { "description": "SF-AUTH-001 / SF-TEN-001" },
          "403": { "description": "SF-AUTH-002 / SF-TEN-002" },
          "409": { "description": "SF-APP-001 / SF-APP-002" }
        }
      }
    },
    "/v1/deficiencies/{deficiency_id}": {
      "get": {
        "operationId": "getDeficiency",
        "parameters": [
          {
            "name": "deficiency_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Notice" },
          "404": { "description": "SF-SYS-002" }
        }
      }
    },
    "/v1/deficiencies/{deficiency_id}/response": {
      "post": {
        "operationId": "respondToDeficiency",
        "parameters": [
          {
            "name": "deficiency_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "narrative_ref",
                  "provided_item_codes",
                  "case_expected_state",
                  "case_expected_version"
                ],
                "properties": {
                  "narrative_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "provided_item_codes": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }
                  },
                  "case_expected_state": { "type": "string" },
                  "case_expected_version": { "type": "integer", "minimum": 1 },
                  "evidence": { "type": "array", "maxItems": 32 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Recorded" },
          "409": { "description": "Illegal transition" }
        }
      }
    },
    "/v1/deficiencies/{deficiency_id}/close": {
      "post": {
        "operationId": "closeDeficiency",
        "parameters": [
          {
            "name": "deficiency_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["close_reason_code"],
                "properties": {
                  "close_reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Closed" }
        }
      }
    },
    "/v1/applications/{application_id}/deficiencies": {
      "get": {
        "operationId": "listApplicationDeficiencies",
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "List" }
        }
      }
    }
  }
}
