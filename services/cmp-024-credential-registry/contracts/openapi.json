{
  "openapi": "3.1.0",
  "info": {
    "title": "CMP-024 Credential Registry / Revocation",
    "version": "0.1.0",
    "description": "Authoritative credential registry status (SF-CON-CREDENTIAL-STATUS). CMP-024 is the only writer of REGISTERED/ACTIVE/SUSPENDED/REVOKED/REISSUED; history is append-only. Tenant from the server-derived request context only. Read ports never mutate status. Suspension/revocation require an opaque reason_code_ref; no statutory grounds are invented. Every route is a PEP call on OPA. Component-local contract; not shared-frozen."
  },
  "paths": {
    "/v1/credential-registry/credentials": {
      "post": {
        "operationId": "registerCredential",
        "description": "SYSTEM (credential engine workload) only. Action CREDENTIAL_REGISTRY_REGISTER. Enters the registry as REGISTERED, history sequence 1.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusView"
                }
              }
            }
          },
          "400": {
            "description": "SF-CON-ERROR-RESPONSE",
