  "components": {
    "schemas": {
      "ErrorResponse": {
        "$ref": "https://contracts.serviceform.ai/error-response/v1"
      },
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_id", "issuer_ref"],
        "properties": {
          "credential_id": {
            "type": "string",
            "format": "uuid"
          },
          "issuer_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          }
        }
      },
      "TransitionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_version"],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "reason_code_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          }
        }
      },
      "ReasonedTransitionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_version", "reason_code_ref"],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "reason_code_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "description": "Opaque ref to an approved reason code in tenant metadata. Not free text; no statutory grounds are defined here."
          }
        }
      },
      "ReissueRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_version", "superseded_by_credential_id"],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "reason_code_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "superseded_by_credential_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "StatusView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_status", "status_version"],
        "properties": {
          "credential_status": {
            "$ref": "https://contracts.serviceform.ai/m07/credential-status/v1"
          },
          "status_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
