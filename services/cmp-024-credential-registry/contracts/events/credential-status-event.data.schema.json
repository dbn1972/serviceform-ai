{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/cmp-024/credential-status-event-data/v1",
  "title": "CredentialStatusEventData",
  "description": "Data of CredentialRegistered / CredentialStatusChanged. Opaque refs only; no PII.",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_id", "issuer_ref", "to_status", "sequence", "status_version"],
  "properties": {
    "credential_id": {
      "type": "string",
      "format": "uuid"
    },
    "issuer_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "from_status": {
      "enum": ["REGISTERED", "ACTIVE", "SUSPENDED", "REVOKED", "REISSUED"]
    },
    "to_status": {
      "enum": ["REGISTERED", "ACTIVE", "SUSPENDED", "REVOKED", "REISSUED"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "status_version": {
      "type": "integer",
      "minimum": 1
    },
    "reason_code_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "superseded_by_credential_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "to_status": {
            "enum": ["SUSPENDED", "REVOKED"]
          }
        }
      },
      "then": {
        "required": ["reason_code_ref"]
      }
    },
    {
      "if": {
        "properties": {
          "to_status": {
            "const": "REISSUED"
          }
        }
      },
      "then": {
        "required": ["superseded_by_credential_id"]
      }
    }
  ]
}
