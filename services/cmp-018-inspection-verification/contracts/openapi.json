{
  "openapi": "3.1.0",
  "info": {
    "title": "CMP-018 Inspection / Verification",
    "version": "0.1.0",
    "description": "Reusable inspection request, scheduling metadata, assignment, checklist, observations, evidence refs, findings, verification result, re-inspection. Verification is NOT statutory approval. Tenant is server-derived. Host mount deferred to SF-M05-009. CMP-012 is not implemented."
  },
  "paths": {
    "/v1/inspections": {
      "post": {
        "operationId": "createInspection",
        "summary": "Create inspection request",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/v1/inspections/available": {
      "get": {
        "operationId": "listAvailableInspections",
        "summary": "List REQUESTED/SCHEDULED inspections matching assignment",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/inspections/{inspection_id}": {
      "get": {
        "operationId": "getInspection",
        "summary": "Get inspection",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/inspections/{inspection_id}/detail": {
      "get": {
        "operationId": "getInspectionDetail",
        "summary": "Checklist, observations, evidence, findings",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/inspections/{inspection_id}/history": {
      "get": {
        "operationId": "getInspectionHistory",
        "summary": "History",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/inspections/{inspection_id}/schedule": {
      "post": {
        "operationId": "scheduleInspection",
        "summary": "Record scheduling metadata (not CMP-056)",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          },
          "201": {
            "description": "created"
          },
          "403": {
            "description": "denied"
          }
        }
      }
    },
