{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentScanned data",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "attempt_no", "verdict", "scanner_mode"],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["CLEAN", "INFECTED", "ERROR"]
    },
    "scanner_mode": {
      "type": "string",
      "enum": ["REAL", "SANDBOX", "SIMULATED"]
    },
    "simulation": {
      "type": "object",
      "description": "SF-CON-SIMULATION-MARKER (INT-013)"
    }
  }
}
