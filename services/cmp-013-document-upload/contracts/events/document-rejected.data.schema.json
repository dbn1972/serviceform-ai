{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentRejected data",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "rejection_code"],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "rejection_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    }
  }
}
