{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/m07/digilocker-publish/v1",
  "title": "DigiLockerPublish",
  "description": "FROZEN. SF-CON-DIGILOCKER-PUBLISH. Request/outcome of publishing an ISSUED credential to DigiLocker (CMP-012 via CMP-037 connector port; INT-013 modes). Requires consent and purpose refs (CMP-030). Exactly-once per idempotency_key; dispatched from the outbox after the issuance transaction commits (no network call inside the authoritative transaction). Publish failure MUST NOT reverse, void or alter credential issuance or registry status. SF-CON-SIMULATION-MARKER is REQUIRED when SIMULATED and forbidden otherwise. Document type and issuer identifiers are opaque metadata refs; this contract MUST NOT invent DigiLocker statutory or partner policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_status",
    "freeze_status",
    "tenant_id",
    "publish_request_id",
    "credential_id",
    "credential_lifecycle_status_at_request",
    "consent_ref",
    "purpose_code",
    "connector_binding_id",
    "integration_contract",
    "connector_mode",
    "document_type_ref",
    "publish_status",
    "attempt_number",
    "idempotency_key",
    "issuance_reversed_on_publish_failure",
    "registry_status_changed_by_publish",
    "invented_statutory_policy_forbidden"
  ],
  "properties": {
    "contract_id": {
      "const": "SF-CON-DIGILOCKER-PUBLISH"
    },
    "contract_status": {
      "const": "FROZEN"
    },
    "freeze_status": {
      "const": "FROZEN"
    },
    "tenant_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "publish_request_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "credential_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "credential_lifecycle_status_at_request": {
      "const": "ISSUED",
      "description": "Only ISSUED credentials are published."
    },
    "consent_ref": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid",
      "description": "CMP-030 consent record id."
    },
    "purpose_code": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/purposeCode"
    },
    "connector_binding_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "integration_contract": {
      "const": "INT-013"
    },
    "connector_mode": {
      "type": "string",
      "enum": ["REAL", "SANDBOX", "SIMULATED"]
    },
    "simulation_marker": {
      "$ref": "https://contracts.serviceform.ai/simulation-marker/v1"
    },
    "document_type_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Opaque ref from connector-binding metadata."
    },
    "publish_status": {
      "type": "string",
      "enum": ["PENDING", "PUBLISHED", "FAILED", "RETRY_SCHEDULED"]
    },
    "provider_transaction_ref": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "failure_code": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/errorCode"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "issuance_reversed_on_publish_failure": {
      "type": "boolean",
      "const": false
    },
    "registry_status_changed_by_publish": {
      "type": "boolean",
      "const": false
    },
    "invented_statutory_policy_forbidden": {
      "type": "boolean",
      "const": true
    },
    "correlation_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "connector_mode": {
            "const": "SIMULATED"
          }
        },
        "required": ["connector_mode"]
      },
      "then": {
        "required": ["simulation_marker"]
      },
      "else": {
        "not": {
          "required": ["simulation_marker"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "publish_status": {
            "const": "PUBLISHED"
          }
        },
        "required": ["publish_status"]
      },
      "then": {
        "required": ["provider_transaction_ref"],
        "properties": {
          "provider_transaction_ref": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publish_status": {
            "enum": ["FAILED", "RETRY_SCHEDULED"]
          }
        },
        "required": ["publish_status"]
      },
      "then": {
        "required": ["failure_code"]
      }
    }
  ]
}
