{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/m07/credential/v1",
  "title": "Credential",
  "description": "FROZEN. SF-CON-CREDENTIAL. Credential issuance record (CMP-022). Generates, signs (via SF-CON-SIGNING-RECORD) and issues a credential from pinned template and service versions after an upstream workflow approval. CMP-022 MUST NOT make or alter the approval decision; it only references it. Registry status (ACTIVE/SUSPENDED/REVOKED/REISSUED) is owned by CMP-024 via SF-CON-CREDENTIAL-STATUS, not by this record. Issued is terminal for this record: DigiLocker publish or notification failure MUST NOT reverse issuance. Artifact bytes are referenced by storage key and SHA-256 only. This contract MUST NOT invent statutory certificate content, validity periods or eSign policy; those come from approved metadata refs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_status",
    "freeze_status",
    "tenant_id",
    "credential_id",
    "application_id",
    "version_pins",
    "template_pin",
    "lifecycle_status",
    "artifacts",
    "issuance_key",
    "idempotency_key",
    "approval_decision_ref",
    "approval_decision_by_this_component",
    "registry_status_owner_cmp",
    "issuance_reversible_by_publish_failure",
    "issuance_reversible_by_notification_failure",
    "invented_statutory_policy_forbidden"
  ],
  "properties": {
    "contract_id": {
      "const": "SF-CON-CREDENTIAL"
    },
    "contract_status": {
      "const": "FROZEN"
    },
    "freeze_status": {
      "const": "FROZEN"
    },
    "tenant_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "credential_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "application_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "version_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_service_binding_id", "service_version_id"],
      "description": "Pins consumed from SF-CON-VERSION-PINNING. Published versions are immutable.",
      "properties": {
        "tenant_service_binding_id": {
          "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
        },
        "service_version_id": {
          "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
        }
      }
    },
    "template_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_template_id", "credential_template_version"],
      "properties": {
        "credential_template_id": {
          "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
        },
        "credential_template_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["GENERATED", "SIGNED", "ISSUED"],
      "description": "Issuance lifecycle owned by CMP-022. Registry status is a separate CMP-024 concern."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_kind", "storage_key", "sha256"],
        "properties": {
          "artifact_kind": {
            "type": "string",
            "enum": ["UNSIGNED_RENDER", "SIGNED_ARTIFACT"]
          },
          "storage_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_./:-]+$",
            "description": "Opaque CMP-032 storage key. No artifact bytes inline."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "signing_record_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid",
      "description": "SF-CON-SIGNING-RECORD reference. Required once SIGNED or ISSUED."
    },
    "issuance_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Business idempotency key: at most one credential per (tenant, application, issuance_key)."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "approval_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Opaque reference to the upstream workflow/human approval (CMP-015/CMP-016/CMP-017). Never an LLM decision."
    },
    "approval_decision_by_this_component": {
      "type": "boolean",
      "const": false
    },
    "registry_status_owner_cmp": {
      "const": "CMP-024"
    },
    "issued_at": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/timestamp"
    },
    "issuance_reversible_by_publish_failure": {
      "type": "boolean",
      "const": false
    },
    "issuance_reversible_by_notification_failure": {
      "type": "boolean",
      "const": false
    },
    "invented_statutory_policy_forbidden": {
      "type": "boolean",
      "const": true
    },
    "correlation_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "enum": ["SIGNED", "ISSUED"]
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "required": ["signing_record_id"],
        "properties": {
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "artifact_kind": {
                  "const": "SIGNED_ARTIFACT"
                }
              },
              "required": ["artifact_kind"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "ISSUED"
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "required": ["issued_at"]
      }
    }
  ]
}
