{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/m07/credential-status/v1",
  "title": "CredentialStatus",
  "description": "FROZEN. SF-CON-CREDENTIAL-STATUS. Authoritative credential registry status and append-only history (CMP-024). CMP-024 is the only writer of registry status; CMP-023 (QR verification) and other consumers read it. History entries are immutable and strictly sequenced. Suspension and revocation carry a reason_code_ref resolved from approved metadata; this contract MUST NOT invent statutory revocation grounds. REISSUED requires the successor credential id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_status",
    "freeze_status",
    "tenant_id",
    "credential_id",
    "issuer_ref",
    "status_authority_cmp",
    "current_status",
    "history",
    "history_append_only",
    "invented_statutory_policy_forbidden"
  ],
  "$defs": {
    "registryStatus": {
      "type": "string",
      "enum": ["REGISTERED", "ACTIVE", "SUSPENDED", "REVOKED", "REISSUED"]
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "sequence", "to_status", "changed_at", "actor", "immutable"],
      "properties": {
        "entry_id": {
          "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "from_status": {
          "oneOf": [{ "$ref": "#/$defs/registryStatus" }, { "type": "null" }]
        },
        "to_status": {
          "$ref": "#/$defs/registryStatus"
        },
        "reason_code_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "description": "Opaque ref to an approved reason code in tenant metadata. Not free text."
        },
        "changed_at": {
          "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/timestamp"
        },
        "actor": {
          "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/actor"
        },
        "immutable": {
          "type": "boolean",
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "to_status": {
                "enum": ["SUSPENDED", "REVOKED"]
              }
            },
            "required": ["to_status"]
          },
          "then": {
            "required": ["reason_code_ref"]
          }
        }
      ]
    }
  },
  "properties": {
    "contract_id": {
      "const": "SF-CON-CREDENTIAL-STATUS"
    },
    "contract_status": {
      "const": "FROZEN"
    },
    "freeze_status": {
      "const": "FROZEN"
    },
    "tenant_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "credential_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "issuer_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Opaque issuing authority ref from tenant metadata. No hard-coded official names."
    },
    "status_authority_cmp": {
      "const": "CMP-024"
    },
    "current_status": {
      "$ref": "#/$defs/registryStatus"
    },
    "superseded_by_credential_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/historyEntry"
      }
    },
    "history_append_only": {
      "type": "boolean",
      "const": true
    },
    "invented_statutory_policy_forbidden": {
      "type": "boolean",
      "const": true
    },
    "correlation_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "current_status": {
            "const": "REISSUED"
          }
        },
        "required": ["current_status"]
      },
      "then": {
        "required": ["superseded_by_credential_id"]
      }
    }
  ]
}
