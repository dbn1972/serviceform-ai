{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/m08/discovery-query/v1",
  "title": "DiscoveryQuery",
  "description": "FROZEN. SF-CON-DISCOVERY-QUERY. Discovery query/result envelope (CMP-006). Jurisdiction/service filters and catalogue version pins. Pagination required. Results are catalogue/search projections — not statutory decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_status",
    "freeze_status",
    "query_id",
    "filters",
    "catalogue_version_id",
    "pagination",
    "result_is_non_statutory"
  ],
  "properties": {
    "contract_id": {
      "const": "SF-CON-DISCOVERY-QUERY"
    },
    "contract_status": {
      "const": "FROZEN"
    },
    "freeze_status": {
      "const": "FROZEN"
    },
    "tenant_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "query_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction_codes"],
      "properties": {
        "jurisdiction_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "service_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "catalogue_version_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "offset"],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result_is_non_statutory": {
      "type": "boolean",
      "const": true
    },
    "correlation_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    }
  }
}
