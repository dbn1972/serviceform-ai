{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/m08/recommendation/v1",
  "title": "Recommendation",
  "description": "FROZEN. SF-CON-RECOMMENDATION. NON_AUTHORITATIVE recommendation result (CMP-007). Decision support only — never final statutory eligibility, approval, rejection, fee waiver grant, or payment disposition. Model calls only via CMP-039 (AI Gateway). Consent markers required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_status",
    "freeze_status",
    "recommendation_id",
    "non_authoritative",
    "authoritative",
    "reason_codes",
    "model_route_ref",
    "ai_gateway_cmp",
    "consent_purpose_code",
    "consent_recorded"
  ],
  "properties": {
    "contract_id": {
      "const": "SF-CON-RECOMMENDATION"
    },
    "contract_status": {
      "const": "FROZEN"
    },
    "freeze_status": {
      "const": "FROZEN"
    },
    "tenant_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "recommendation_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "application_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "non_authoritative": {
      "type": "boolean",
      "const": true
    },
    "authoritative": {
      "type": "boolean",
      "const": false,
      "description": "Must remain false. Recommendations are NON_AUTHORITATIVE."
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Z0-9_.-]+$"
      }
    },
    "model_route_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "CMP-039 model/route reference. Direct model calls outside AI Gateway are forbidden."
    },
    "ai_gateway_cmp": {
      "const": "CMP-039"
    },
    "consent_purpose_code": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/purposeCode"
    },
    "consent_recorded": {
      "type": "boolean",
      "const": true
    },
    "correlation_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    }
  }
}
