{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.serviceform.ai/m09/sfpackagemanifest/v1",
  "title": "SfPackageManifest",
  "description": "FROZEN. SF-CON-SFPACKAGE-MANIFEST. Signed .sfpackage promotion manifest. Content-addressed; no embedded secrets. Dependency versions pinned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_status",
    "freeze_status",
    "tenant_id",
    "idempotency_key",
    "invented_statutory_policy_forbidden",
    "package_id",
    "content_address",
    "artifact_hashes",
    "signature_ref",
    "embedded_secrets_forbidden"
  ],
  "properties": {
    "contract_id": {
      "const": "SF-CON-SFPACKAGE-MANIFEST"
    },
    "contract_status": {
      "const": "FROZEN"
    },
    "freeze_status": {
      "const": "FROZEN"
    },
    "tenant_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "invented_statutory_policy_forbidden": {
      "type": "boolean",
      "const": true
    },
    "correlation_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "package_id": {
      "$ref": "https://contracts.serviceform.ai/common/v1#/$defs/uuid"
    },
    "content_address": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dependency_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 64
      }
    },
    "embedded_secrets_forbidden": {
      "type": "boolean",
      "const": true
    }
  }
}
