# ADR-0008 trusted BFF hops — NAME STUB ONLY.
# Empty/unset → trustProxy:false (secure default). PRODUCTION refuses loopback-only hops.
# Do not set * / true / 0.0.0.0/0 / ::/0. CERTIFIED=false. G6=false. ADR-0008 Status=PROPOSED.

# Comma-separated BFF hop IPs/CIDRs observed by the API (owner network plan):
SF_TRUSTED_PROXY_HOPS=OWNER_REQUIRED
# SAMPLE_LAB / LOCAL shared-host example (NOT for PRODUCTION):
# SF_TRUSTED_PROXY_HOPS=127.0.0.1,::1
