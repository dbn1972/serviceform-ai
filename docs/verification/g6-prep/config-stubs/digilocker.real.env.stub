# DigiLocker REAL switch — NAME STUB ONLY.
# Do not invent credentials, doc types, or PE-IDs. Leave OWNER_REQUIRED until owner fills
# via secret store. Never commit real values. CERTIFIED=false. G6=false.
#
# INT-013: PRODUCTION critical DigiLocker binding must be mode=REAL with secret_ref.
# SAMPLE_LAB_* document types are refused as production critical bindings.

SF_ENVIRONMENT=OWNER_REQUIRED
# CMP-037 / host composition (names only — values from vault):
SF_DIGILOCKER_CONNECTOR_MODE=REAL
SF_DIGILOCKER_CONNECTOR_BINDING_ID=OWNER_REQUIRED
SF_DIGILOCKER_SECRET_REF=OWNER_REQUIRED
# Registered issuer document type — must NOT start with SAMPLE_LAB_
SF_DIGILOCKER_DOC_TYPE=OWNER_REQUIRED
# Optional SANDBOX base URL when registrar provides a non-prod endpoint:
SF_DIGILOCKER_API_BASE_URL=OWNER_REQUIRED
