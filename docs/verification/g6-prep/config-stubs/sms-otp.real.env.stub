# SMS / OTP REAL switch — NAME STUB ONLY.
# No DLT PE-IDs, templates, or API keys invented. CERTIFIED=false. G6=false.
#
# Lab today: SimulatedOtpAdapter + /v1/simulated/* inbox (refused in PRODUCTION).
# ADR-0008 should be accepted and SF_TRUSTED_PROXY_HOPS set before exposing REAL OTP.

SF_ENVIRONMENT=OWNER_REQUIRED
SF_OTP_CONNECTOR_MODE=REAL
SF_OTP_CONNECTOR_BINDING_ID=OWNER_REQUIRED
SF_OTP_SECRET_REF=OWNER_REQUIRED
# Provider / DLT template identifiers — owner registry only:
SF_SMS_PROVIDER=OWNER_REQUIRED
SF_SMS_DLT_PE_ID=OWNER_REQUIRED
SF_SMS_TEMPLATE_ID=OWNER_REQUIRED
# See trusted-proxy.adr0008.env.stub for hop CIDRs (required for per-client limits).
