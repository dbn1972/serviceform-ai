# Runtime configuration read by apps/api (see apps/api/src/config.ts). Copy to .env for local
# runs. Real environments receive these from the deployment platform and secret store.
SF_ENVIRONMENT=LOCAL
SF_CELL_ID=cell-local
SF_SERVICE_NAME=serviceform-api
SF_SERVICE_VERSION=0.0.0-dev
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Format: postgres://USER:PASS@127.0.0.1:5432/serviceform (USER/PASS from infra/local/.env)
DATABASE_URL=
# http://127.0.0.1:4318 to export traces/metrics to the local collector
OTEL_EXPORTER_OTLP_ENDPOINT=
